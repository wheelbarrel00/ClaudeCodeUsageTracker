{
  "name": "claude-code-usage-tracker-wb00",
  "displayName": "Claude Code Usage & Cost Tracker",
  "description": "Track your Claude Code token usage and estimated cost from your local logs, right in the status bar.",
  "version": "1.7.0",
  "publisher": "wheelbarrel00",
  "author": {
    "name": "Wheelbarrel00"
  },
  "license": "MIT",
  "sponsor": {
    "url": "https://github.com/sponsors/wheelbarrel00"
  },
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/wheelbarrel00/ClaudeCodeUsageTracker.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "claude",
    "claude code",
    "usage",
    "cost",
    "tokens"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "icons": {
      "ccut-claude": {
        "description": "Claude sunburst",
        "default": {
          "fontPath": "./media/ccut.woff",
          "fontCharacter": "\\E000"
        }
      }
    },
    "commands": [
      {
        "command": "claudeCodeUsageTracker.showDashboard",
        "title": "%command.showDashboard.title%"
      },
      {
        "command": "claudeCodeUsageTracker.refresh",
        "title": "%command.refresh.title%"
      },
      {
        "command": "claudeCodeUsageTracker.setAiApiKey",
        "title": "%command.setAiApiKey.title%"
      },
      {
        "command": "claudeCodeUsageTracker.clearAiApiKey",
        "title": "%command.clearAiApiKey.title%"
      }
    ],
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "claudeCodeUsageTracker.refreshIntervalSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 5,
          "maximum": 3600,
          "description": "%config.refreshIntervalSeconds.description%"
        },
        "claudeCodeUsageTracker.currency": {
          "type": "string",
          "default": "USD",
          "description": "%config.currency.description%"
        },
        "claudeCodeUsageTracker.decimalPlaces": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "maximum": 6,
          "description": "%config.decimalPlaces.description%"
        },
        "claudeCodeUsageTracker.showLimits": {
          "type": "boolean",
          "default": true,
          "description": "%config.showLimits.description%"
        },
        "claudeCodeUsageTracker.useLiveApi": {
          "type": "boolean",
          "default": true,
          "description": "%config.useLiveApi.description%"
        },
        "claudeCodeUsageTracker.liveApiMinIntervalSeconds": {
          "type": "number",
          "default": 180,
          "minimum": 60,
          "maximum": 3600,
          "description": "%config.liveApiMinIntervalSeconds.description%"
        },
        "claudeCodeUsageTracker.showModelWeekly": {
          "type": "boolean",
          "default": false,
          "description": "%config.showModelWeekly.description%"
        },
        "claudeCodeUsageTracker.showOpusWeekly": {
          "type": "boolean",
          "default": false,
          "description": "%config.showOpusWeekly.description%",
          "deprecationMessage": "%config.showOpusWeekly.deprecationMessage%"
        },
        "claudeCodeUsageTracker.showContext": {
          "type": "boolean",
          "default": true,
          "description": "%config.showContext.description%"
        },
        "claudeCodeUsageTracker.projectGroupingMode": {
          "type": "string",
          "enum": [
            "git",
            "folder",
            "flat"
          ],
          "enumDescriptions": [
            "%config.projectGroupingMode.enumDescriptions.git%",
            "%config.projectGroupingMode.enumDescriptions.folder%",
            "%config.projectGroupingMode.enumDescriptions.flat%"
          ],
          "default": "git",
          "description": "%config.projectGroupingMode.description%"
        },
        "claudeCodeUsageTracker.showCost": {
          "type": "boolean",
          "default": true,
          "description": "%config.showCost.description%"
        },
        "claudeCodeUsageTracker.showTokens": {
          "type": "boolean",
          "default": true,
          "description": "%config.showTokens.description%"
        },
        "claudeCodeUsageTracker.showExtraUsage": {
          "type": "boolean",
          "default": false,
          "description": "%config.showExtraUsage.description%"
        },
        "claudeCodeUsageTracker.predictiveAlerts.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.predictiveAlerts.enabled.description%"
        },
        "claudeCodeUsageTracker.predictiveAlerts.windowMinutes": {
          "type": "number",
          "default": 15,
          "minimum": 1,
          "maximum": 300,
          "description": "%config.predictiveAlerts.windowMinutes.description%"
        },
        "claudeCodeUsageTracker.predictiveAlerts.warnThresholds": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "default": [
            75,
            90
          ],
          "description": "%config.predictiveAlerts.warnThresholds.description%",
          "minItems": 1
        },
        "claudeCodeUsageTracker.predictiveAlerts.predictBreach": {
          "type": "boolean",
          "default": true,
          "description": "%config.predictiveAlerts.predictBreach.description%"
        },
        "claudeCodeUsageTracker.predictiveAlerts.showFiveHourEta": {
          "type": "boolean",
          "default": true,
          "description": "%config.predictiveAlerts.showFiveHourEta.description%"
        },
        "claudeCodeUsageTracker.predictiveAlerts.showWeeklyEta": {
          "type": "boolean",
          "default": true,
          "description": "%config.predictiveAlerts.showWeeklyEta.description%"
        },
        "claudeCodeUsageTracker.predictiveAlerts.modelAdvisor.enabled": {
          "type": "boolean",
          "default": false,
          "description": "%config.predictiveAlerts.modelAdvisor.enabled.description%"
        },
        "claudeCodeUsageTracker.advisor.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.advisor.enabled.description%"
        },
        "claudeCodeUsageTracker.advisor.ai.model": {
          "type": "string",
          "default": "claude-sonnet-5",
          "description": "%config.advisor.ai.model.description%"
        },
        "claudeCodeUsageTracker.advisor.ai.includePrompts": {
          "type": "boolean",
          "default": false,
          "description": "%config.advisor.ai.includePrompts.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node --test \"out/**/*.test.js\"",
    "gen:icons": "node scripts/gen-icons.js"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/vscode": "^1.85.0",
    "svg2ttf": "^6.1.0",
    "svgicons2svgfont": "^16.0.0",
    "ttf2woff": "^3.0.0",
    "typescript": "^5.4.5"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Usage data is read from ~/.claude on the local filesystem, which a virtual workspace does not have."
    }
  }
}
